[
  {
    "ayah": 1,
    "ar": " أَرَءَيْتَ ٱلَّذِى يُكَذِّبُ بِٱلدِّينِ",
    "fa": "(ای پیامبر) آیا کسی‌که روز جزا را تکذیب می‌کند دیده‌ای؟!"
  },
  {
    "ayah": 2,
    "ar": "فَذَٰلِكَ ٱلَّذِى يَدُعُّ ٱلْيَتِيمَ",
    "fa": "پس او (همان) کسی‌که یتیم را (با خشونت از خود) می‌راند."
  },
  {
    "ayah": 3,
    "ar": "وَلَا يَحُضُّ عَلَىٰ طَعَامِ ٱلْمِسْكِينِ",
    "fa": "و (دیگران را) به اطعام بی‌نوا (و مسکین) ترغیب و تشویق نمی‌کند."
  },
  {
    "ayah": 4,
    "ar": "فَوَيْلٌ لِّلْمُصَلِّينَ",
    "fa": "پس وای بر نماز گزاران."
  },
  {
    "ayah": 5,
    "ar": "ٱلَّذِينَ هُمْ عَن صَلَاتِهِمْ سَاهُونَ",
    "fa": "همان کسانی‌که از نماز‌شان غافلند."
  },
  {
    "ayah": 6,
    "ar": "ٱلَّذِينَ هُمْ يُرَآءُونَ",
    "fa": "کسانی‌که خودنمایی می‌کنند."
  },
  {
    "ayah": 7,
    "ar": "وَيَمْنَعُونَ ٱلْمَاعُونَ",
    "fa": "و (از پرداخت زکات و) عاریت دادن وسایل ضروری زندگی دریغ می‌ورزند."
  }
]