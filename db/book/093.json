[
  {
    "ayah": 1,
    "ar": " وَٱلضُّحَىٰ",
    "fa": "سوگند به آغاز روز."
  },
  {
    "ayah": 2,
    "ar": "وَٱلَّيْلِ إِذَا سَجَىٰ",
    "fa": "و سوگند به شب هنگامی‌که آرام گیرد."
  },
  {
    "ayah": 3,
    "ar": "مَا وَدَّعَكَ رَبُّكَ وَمَا قَلَىٰ",
    "fa": "(که) پروردگارت تو را وا نگذاشته و (بر تو) خشم نگرفته است."
  },
  {
    "ayah": 4,
    "ar": "وَلَلْـَٔاخِرَةُ خَيْرٌ لَّكَ مِنَ ٱلْأُولَىٰ",
    "fa": "و مسلماً آخرت برای تو از دنیا بهتر است."
  },
  {
    "ayah": 5,
    "ar": "وَلَسَوْفَ يُعْطِيكَ رَبُّكَ فَتَرْضَىٰٓ",
    "fa": "و به‌زودی پروردگارت به تو (آن قدر) عطا کند که خشنود گردی."
  },
  {
    "ayah": 6,
    "ar": "أَلَمْ يَجِدْكَ يَتِيمًا فَـَٔاوَىٰ",
    "fa": "آیا تو را یتیم نیافت، پس پناه داد؟!"
  },
  {
    "ayah": 7,
    "ar": "وَوَجَدَكَ ضَآلًّا فَهَدَىٰ",
    "fa": "و تو را (راه نایافته و) سرگشته یافت، پس هدایت کرد،"
  },
  {
    "ayah": 8,
    "ar": "وَوَجَدَكَ عَآئِلًا فَأَغْنَىٰ",
    "fa": "و تو را فقیر یافت، پس بی‌نیاز نمود،"
  },
  {
    "ayah": 9,
    "ar": "فَأَمَّا ٱلْيَتِيمَ فَلَا تَقْهَرْ",
    "fa": "پس (توهم) یتیم را میازار."
  },
  {
    "ayah": 10,
    "ar": "وَأَمَّا ٱلسَّآئِلَ فَلَا تَنْهَرْ",
    "fa": "و سؤال کننده را مران (و با او خشونت نکن)."
  },
  {
    "ayah": 11,
    "ar": "وَأَمَّا بِنِعْمَةِ رَبِّكَ فَحَدِّثْ",
    "fa": "و نعمت‌های پروردگارت را باز گوکن و سپاس گذار."
  }
]