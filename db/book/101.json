[
  {
    "ayah": 1,
    "ar": " ٱلْقَارِعَةُ",
    "fa": "فرو کوبنده."
  },
  {
    "ayah": 2,
    "ar": "مَا ٱلْقَارِعَةُ",
    "fa": "چیست (آن) فرو کوبنده؟"
  },
  {
    "ayah": 3,
    "ar": "وَمَآ أَدْرَىٰكَ مَا ٱلْقَارِعَةُ",
    "fa": "و تو چه می‌دانی که (آن) فرو کوبنده چیست؟"
  },
  {
    "ayah": 4,
    "ar": "يَوْمَ يَكُونُ ٱلنَّاسُ كَٱلْفَرَاشِ ٱلْمَبْثُوثِ",
    "fa": "روزی‌که مردم مانند پروانه‌های پراکنده خواهند بود."
  },
  {
    "ayah": 5,
    "ar": "وَتَكُونُ ٱلْجِبَالُ كَٱلْعِهْنِ ٱلْمَنفُوشِ",
    "fa": "و گوه‌ها مانند پشم رنگین حلاجی شده خواهد بود."
  },
  {
    "ayah": 6,
    "ar": "فَأَمَّا مَن ثَقُلَتْ مَوَٰزِينُهُۥ",
    "fa": "پس اما هرکس که (در آن روز) کفۀ میزانش سنگین باشد."
  },
  {
    "ayah": 7,
    "ar": "فَهُوَ فِى عِيشَةٍ رَّاضِيَةٍ",
    "fa": "در یک زندگی خشنود (و پسندیده‌ای) خواهد بود."
  },
  {
    "ayah": 8,
    "ar": "وَأَمَّا مَنْ خَفَّتْ مَوَٰزِينُهُۥ",
    "fa": "و اما هرکس که کفۀ میزانش سبک باشد."
  },
  {
    "ayah": 9,
    "ar": "فَأُمُّهُۥ هَاوِيَةٌ",
    "fa": "پس (مسکن و) پناهگاهش هاویه است."
  },
  {
    "ayah": 10,
    "ar": "وَمَآ أَدْرَىٰكَ مَا هِيَهْ",
    "fa": "و تو چه دانی که آن (هاویه) چیست؟"
  },
  {
    "ayah": 11,
    "ar": "نَارٌ حَامِيَةٌۢ",
    "fa": "آتشی سوزان (و شعله‌ور) است."
  }
